<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/watch_next_card_root"
    android:layout_width="@dimen/watch_next_card_width"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:duplicateParentState="true"
    android:longClickable="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/app_graphic_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/watch_next_card_height"
        android:clipToOutline="true"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/app_banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_border_only"
            android:backgroundTint="@android:color/black"
            android:clipToOutline="true"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Flush with the bottom edge of the image, spanning its whole width. The container
             clips to its rounded outline, so the ends follow the card's corners. -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/watch_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:visibility="invisible"
            app:trackColor="#66000000"
            app:trackCornerRadius="0dp"
            app:trackThickness="5dp" />

    </FrameLayout>

    <TextView
        android:id="@+id/title"
        style="@style/WatchNextCardTitle"
        android:layout_width="@dimen/watch_next_card_width"
        android:layout_height="wrap_content" />

</LinearLayout>
