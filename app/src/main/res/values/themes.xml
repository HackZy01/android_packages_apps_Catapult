<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Material3.Dark.NoActionBar.Leanback" tools:ignore="PrivateResource">
        <!--
             Keep in sync with whatever Theme.AppCompat.LeanbackBase
             adds on top of Theme.AppCompat.NoActionBar

             Changes made:
             - viewInflaterClass: Removed
             - ?android:attr/colorAccent -> ?attr/colorAccent
             - ?android:attr/colorPrimary -> ?attr/colorPrimary
             - ?android:attr/colorPrimaryDark -> ?attr/colorPrimaryDark
             - @color/lb_default_brand_color -> ?attr/colorPrimary
             - @color/lb_default_brand_color_dark -> ?attr/colorPrimaryDark
        -->
        <item name="playbackProgressPrimaryColor">?attr/colorAccent</item>
        <item name="playbackControlsIconHighlightColor">?attr/colorAccent</item>
        <item name="defaultBrandColor">?attr/colorPrimary</item>
        <item name="android:colorPrimary">?attr/colorPrimary</item>
        <item name="defaultBrandColorDark">?attr/colorPrimaryDark</item>
        <item name="android:colorPrimaryDark">?attr/colorPrimaryDark</item>

        <item name="android:windowOverscan">true</item>
        <item name="guidedStepTheme">@style/Theme.AppCompat.Leanback.GuidedStep</item>

        <item name="android:windowSharedElementEnterTransition">
            @transition/lb_shared_element_enter_transition
        </item>

        <item name="android:windowSharedElementReturnTransition">
            @transition/lb_shared_element_return_transition
        </item>
        <item name="android:windowEnterTransition">@transition/lb_enter_transition</item>
        <item name="android:windowReturnTransition">@transition/lb_return_transition</item>
        <item name="android:windowTransitionBackgroundFadeDuration">350</item>
    </style>

    <!--
         Fixed dark color scheme built from the palette in colors.xml, so the launcher looks the
         same on every Android version (no dynamic colors).
    -->
    <style name="Theme.Catapult" parent="Theme.Material3.Dark.NoActionBar.Leanback">
        <item name="colorPrimary">@color/system_accent1_200_dark</item>
        <item name="colorOnPrimary">@color/system_accent1_800_dark</item>
        <item name="colorPrimaryContainer">@color/system_accent1_700_dark</item>
        <item name="colorOnPrimaryContainer">@color/system_accent1_100_dark</item>
        <item name="colorPrimaryInverse">@color/system_accent1_600_dark</item>

        <item name="colorSecondary">@color/system_accent2_200_dark</item>
        <item name="colorOnSecondary">@color/system_accent2_800_dark</item>
        <item name="colorSecondaryContainer">@color/system_accent2_700_dark</item>
        <item name="colorOnSecondaryContainer">@color/system_accent2_100_dark</item>

        <item name="colorTertiary">@color/system_accent3_200_dark</item>
        <item name="colorOnTertiary">@color/system_accent3_800_dark</item>
        <item name="colorTertiaryContainer">@color/system_accent3_700_dark</item>
        <item name="colorOnTertiaryContainer">@color/system_accent3_100_dark</item>

        <item name="android:colorBackground">@color/m3_ref_palette_dynamic_neutral6</item>
        <item name="colorOnBackground">@color/system_neutral1_100_dark</item>
        <item name="colorSurface">@color/m3_ref_palette_dynamic_neutral6</item>
        <item name="colorOnSurface">@color/system_neutral1_100_dark</item>
        <item name="colorSurfaceVariant">@color/system_neutral2_700_dark</item>
        <item name="colorOnSurfaceVariant">@color/system_neutral2_200_dark</item>
        <item name="colorSurfaceInverse">@color/system_neutral1_100_dark</item>
        <item name="colorOnSurfaceInverse">@color/system_neutral1_800_dark</item>
        <item name="colorOutline">@color/system_neutral2_400_dark</item>
        <item name="colorOutlineVariant">@color/system_neutral2_700_dark</item>

        <item name="colorSurfaceContainerLow">@color/system_neutral1_900_dark</item>
        <item name="colorSurfaceContainer">@color/m3_ref_palette_dynamic_neutral12</item>
        <item name="colorSurfaceContainerHigh">@color/m3_ref_palette_dynamic_neutral17</item>
        <item name="colorSurfaceContainerHighest">@color/m3_ref_palette_dynamic_neutral22</item>

        <!-- Legacy attributes used by Leanback and a few of our own layouts -->
        <item name="colorAccent">@color/system_accent1_200_dark</item>
        <item name="colorPrimaryDark">@color/system_accent1_800_dark</item>
    </style>

    <style name="Theme.Catapult.SideActivity">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@drawable/rounded_background</item>
    </style>
</resources>
